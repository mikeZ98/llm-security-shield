# Copy to .env (gitignored) for docker compose. Never commit real secrets.

# Enables API-key auth on /v1/shield/* and the deanonymize endpoint. >= 32 characters,
# e.g. generated with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SHIELD_API_API_KEY=

# Optional overrides (defaults shown in docker-compose.yml).
# SHIELD_INJECTION_RISK_THRESHOLD=0.7
# SHIELD_AUDIT_LOG_LEVEL=INFO
# SHIELD_API_PROTECTED_PATH_PREFIXES=["/v1/chat"]
# SHIELD_BIND=127.0.0.1
